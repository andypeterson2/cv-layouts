%!TEX TS-program = xelatex
%!TEX encoding = UTF-8 Unicode

\documentclass[<<style.fontSize>>, <<style.pageSize>>]{awesome-cv}

% Page geometry — horizontalMargin applies to both left and right
\geometry{left=<<spacing.horizontalMargin>>, top=<<spacing.marginTop>>, right=<<spacing.horizontalMargin>>, bottom=<<spacing.marginBottom>>, footskip=<<spacing.footskip>>}

% Accent color
<% if style.accent.kind == 'preset' %>
\colorlet{awesome}{<<style.accent.value>>}
<% elif style.accent.kind == 'hex' %>
\definecolor{awesome}{HTML}{<<style.accent.value>>}
<% endif %>

\setbool{acvSectionColorHighlight}{true}

\renewcommand{\acvHeaderSocialSep}{\quad\textbar\quad}

% Interword spaces never shrink below their natural width, so a justified line
% cannot squeeze them small enough for a text extractor to read as no space.
<% if style.fontFamily == 'roboto' %>
\setmainfont{Roboto}[
  UprightFont=*,
  ItalicFont=*-Italic,
  BoldFont=*-Bold,
  BoldItalicFont=*-BoldItalic,
  FontFace={l}{n}{Font=*-Light,WordSpace={1,1.6,0}},
  FontFace={l}{it}{Font=*-LightItalic,WordSpace={1,1.6,0}},
  WordSpace={1,1.6,0},
]
\setsansfont{Roboto}[
  UprightFont=*,
  ItalicFont=*-Italic,
  BoldFont=*-Bold,
  BoldItalicFont=*-BoldItalic,
  FontFace={l}{n}{Font=*-Light,WordSpace={1,1.6,0}},
  FontFace={l}{it}{Font=*-LightItalic,WordSpace={1,1.6,0}},
  WordSpace={1,1.6,0},
]
<% else %>
% CV Sans is Source Sans 3 with each space and hyphen glyph mapped to one
% character only, so extractors read U+0020 and U+002D, not U+00A0 and U+2011.
\setmainfont{CVSans}[
  Path=./,
  Extension=.otf,
  UprightFont=*-Regular,
  ItalicFont=*-It,
  BoldFont=*-Bold,
  BoldItalicFont=*-BoldIt,
  FontFace={l}{n}{Font=*-Light,WordSpace={1,1.6,0}},
  FontFace={l}{it}{Font=*-LightIt,WordSpace={1,1.6,0}},
  WordSpace={1,1.6,0},
]
\setsansfont{CVSans}[
  Path=./,
  Extension=.otf,
  UprightFont=*-Regular,
  ItalicFont=*-It,
  BoldFont=*-Bold,
  BoldItalicFont=*-BoldIt,
  FontFace={l}{n}{Font=*-Light,WordSpace={1,1.6,0}},
  FontFace={l}{it}{Font=*-LightIt,WordSpace={1,1.6,0}},
  WordSpace={1,1.6,0},
]
<% endif %>
% Interword space that also carries a zero-width space glyph, so extractors
% that only trust real space characters still split the words.
\newcommand*{\cvsp}{%
  \ifnum\XeTeXcharglyph"0020>0 \makebox[0pt][l]{\XeTeXglyph\XeTeXcharglyph"0020\relax}\fi\ }

% Text layer: extract the source characters, never split words, keep symbols visible
\XeTeXgenerateactualtext=1
\hyphenpenalty=10000
\exhyphenpenalty=10000
\emergencystretch=3em
<< symbolFallback() >>

% Header spacing overrides — headerLineGap applies to name and position rows
\renewcommand{\acvHeaderAfterNameSkip}{<<spacing.headerLineGap>>}
\renewcommand{\acvHeaderAfterPositionSkip}{<<spacing.headerLineGap>>}
\renewcommand{\acvHeaderAfterAddressSkip}{<<spacing.headerAfterAddressSkip>>}
\renewcommand{\acvHeaderAfterSocialSkip}{<<spacing.headerAfterSocialSkip>>}
\renewcommand{\acvHeaderAfterQuoteSkip}{<<spacing.headerAfterQuoteSkip>>}

% Section spacing overrides
\renewcommand{\acvSectionTopSkip}{<<spacing.sectionTopSkip>>}
\renewcommand{\acvSectionContentTopSkip}{<<spacing.sectionContentTopSkip>>}

% Font size overrides
\renewcommand*{\headerfirstnamestyle}[1]{{\fontsize{<<fonts.headerNameSize>>}{1em}\headerfontlight\color{graytext} #1}}
\renewcommand*{\headerlastnamestyle}[1]{{\fontsize{<<fonts.headerNameSize>>}{1em}\headerfont\bfseries\color{text} #1}}
\renewcommand*{\headerpositionstyle}[1]{{\fontsize{<<fonts.headerPositionSize>>}{1em}\bodyfont\scshape\color{awesome} #1}}
\renewcommand*{\headersocialstyle}[1]{{\fontsize{<<fonts.headerSocialSize>>}{1em}\headerfont\color{text} #1}}
\renewcommand*{\headeraddressstyle}[1]{{\fontsize{<<fonts.secondaryTextSize>>}{1em}\headerfont\itshape\color{lighttext} #1}}
\renewcommand*{\footerstyle}[1]{{\fontsize{<<fonts.secondaryTextSize>>}{1em}\footerfont\scshape\color{lighttext} #1}}
\renewcommand*{\entrypositionstyle}[1]{{\fontsize{<<fonts.secondaryTextSize>>}{1em}\bodyfont\scshape\color{graytext} #1}}
\renewcommand*{\entrydatestyle}[1]{{\fontsize{<<fonts.secondaryTextSize>>}{1em}\bodyfontlight\slshape\color{graytext} #1}}
\renewcommand*{\headerquotestyle}[1]{{\fontsize{<<fonts.contentTextSize>>}{1em}\bodyfont\itshape\color{darktext} #1}}
\renewcommand{\paragraphstyle}{\fontsize{<<fonts.contentTextSize>>}{1em}\bodyfontlight\upshape\color{text}}
\renewcommand*{\entrylocationstyle}[1]{{\fontsize{<<fonts.contentTextSize>>}{1em}\bodyfontlight\slshape\color{awesome} #1}}
\renewcommand*{\descriptionstyle}[1]{{\fontsize{<<fonts.contentTextSize>>}{1em}\bodyfontlight\upshape\color{text} #1}}
\renewcommand*{\honortitlestyle}[1]{{\fontsize{<<fonts.contentTextSize>>}{1em}\bodyfont\color{graytext} #1}}
\renewcommand*{\honorpositionstyle}[1]{{\fontsize{<<fonts.contentTextSize>>}{1em}\bodyfont\bfseries\color{darktext} #1}}
\renewcommand*{\honordatestyle}[1]{{\fontsize{<<fonts.contentTextSize>>}{1em}\bodyfont\color{graytext} #1}}
\renewcommand*{\honorlocationstyle}[1]{{\fontsize{<<fonts.contentTextSize>>}{1em}\bodyfontlight\slshape\color{awesome} #1}}
\renewcommand*{\skillsetstyle}[1]{{\fontsize{<<fonts.contentTextSize>>}{1em}\bodyfontlight\color{text} #1}}
\renewcommand*{\entrytitlestyle}[1]{{\fontsize{<<fonts.itemTitleSize>>}{1em}\bodyfont\bfseries\color{darktext} #1}}
\renewcommand*{\skilltypestyle}[1]{{\fontsize{<<fonts.itemTitleSize>>}{1em}\bodyfont\bfseries\color{darktext} #1}}
\renewcommand*{\sectionstyleface}[1]{{\fontsize{<<fonts.sectionTitleSize>>}{1em}\bodyfont\bfseries #1}}
\renewcommand*{\subsectionstyle}[1]{{\fontsize{<<fonts.subsectionTitleSize>>}{1em}\bodyfont\scshape\textcolor{text}{#1}}}

% Section heading, given as its accented first three characters and the rest.
% It ends on a strut so every heading has the same depth, whatever descenders
% its title has.
\newcommand{\cvsectionparts}[2]{%
  \vspace{\acvSectionTopSkip}
  \ifthenelse{\boolean{acvSectionColorHighlight}}%
    {\color{awesome}\sectionstyleface{#1\color{text}{#2}}}%
    {\color{text}\sectionstyleface{#1#2}}%
  \phantomsection
  \color{sectiondivider}\vhrulefill{0.9pt}\strut
}

% Entries stack without list spacing: sectionContentTopSkip sits under the
% heading, contentTopAdjust above every entry, paragraphBottomSkip below the last.
\renewenvironment{cventries}{%
  \par
  \vspace{\acvSectionContentTopSkip}
  \centering
}{%
  \par
  \vspace{<<spacing.paragraphBottomSkip>>}
}

% Entry box: each entry is its own top-aligned paragraph with no interline glue,
% so contentTopAdjust alone sets the space above it.
\renewcommand*{\cventry}[5]{%
  \par\nointerlineskip
  \vspace{<<spacing.contentTopAdjust>>}%
  \setlength\tabcolsep{0pt}%
  \setlength{\extrarowheight}{0pt}%
  \noindent\begin{tabular*}{\textwidth}[t]{@{\extracolsep{\fill}} L{\textwidth - 4.5cm} R{4.5cm}}
    \ifempty{#2#3}
      {\entrypositionstyle{#1} & \entrydatestyle{#4} \\}
      {\entrytitlestyle{#2} & \entrylocationstyle{#3} \\
      \entrypositionstyle{#1} & \entrydatestyle{#4} \\}
    \ifstrempty{#5}
      {}
      {\multicolumn{2}{L{\textwidth}}{\descriptionstyle{#5}} \\}
  \end{tabular*}%
  \par
}

\renewenvironment{cvitems}{%
  \vspace{<<spacing.itemsTopSkip>>}
  \begin{justify}
  \begin{itemize}[leftmargin=<<spacing.itemsLeftMargin>>, nosep, noitemsep]
    \setlength{\parskip}{0pt}
    \renewcommand{\labelitemi}{\bullet}
}{%
  \end{itemize}
  \end{justify}
  \vspace{<<spacing.itemsBottomSkip>>}
}

\renewenvironment{cvskills}{%
  \vspace{\acvSectionContentTopSkip}
  \vspace{<<spacing.paragraphTopAdjust>>}
  \vspace{1.4mm}
  \begingroup
  \setlength{\parindent}{0pt}
  \setlength{\parskip}{0.3em}
  \raggedright
}{%
  \par
  \endgroup
  \vspace{<<spacing.paragraphBottomSkip>>}
}

\renewcommand*{\cvskill}[2]{%
  {\fontsize{<<fonts.contentTextSize>>}{1em}\selectfont\bodyfontlight\color{text}%
  \ifstrempty{#1}{}{{\bodyfont\bfseries\color{darktext}#1:}\ }#2\par}%
}

\renewenvironment{cvparagraph}{%
  \vspace{\acvSectionContentTopSkip}
  \vspace{<<spacing.paragraphTopAdjust>>}
  \paragraphstyle
}{%
  \par
  \vspace{<<spacing.paragraphBottomSkip>>}
}

<% include "templates/partials/data.njk" %>
