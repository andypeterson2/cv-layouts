<# Section-type macros. Each reproduces the matching legacy serialize*()
   output. Cosmetic comment separators are omitted, BUT the blank line after
   every \cvsection{...} is load-bearing: \cvsection ends its line with a
   \vhrulefill rule and emits no break, so the blank line's \par is what drops
   the body onto the next line. Without it the body typesets on the rule. #>

<% macro cventries(s) %>
\cvsectionparts{<<s.title.slice(0, 3) | tex>>}{<<s.title.slice(3) | tex | replace(" ", "\\cvsp ")>>}

\begin{cventries}
<% for e in s.entries %>
  \cventry
    {<<e.position | tex | replace(" ", "\\cvsp ")>>}
    {<<e.organization | tex | replace(" ", "\\cvsp ")>>}
    {<<e.location | tex | replace(" ", "\\cvsp ")>>}
    {<<e.date | tex | replace(" ", "\\cvsp ")>>}
<% if e.items and e.items.length > 0 %>
    {
      \begin{cvitems}
<% for item in e.items %>
        \item {<<item | tex | replace(" ", "\\cvsp ")>>}
<% endfor %>
      \end{cvitems}
    }
<% else %>
    {}
<% endif %>
<% endfor %>
\end{cventries}
<% endmacro %>

<% macro cvskills(s) %>
\cvsectionparts{<<s.title.slice(0, 3) | tex>>}{<<s.title.slice(3) | tex | replace(" ", "\\cvsp ")>>}

\begin{cvskills}
<% for e in s.entries %>
  \cvskill
    {<<e.category | tex | replace(" ", "\\cvsp ")>>}
    {<<e.skills | tex | replace(" ", "\\cvsp ")>>}
<% endfor %>
\end{cvskills}
<% endmacro %>

<% macro cvhonors(s) %>
\cvsectionparts{<<s.title.slice(0, 3) | tex>>}{<<s.title.slice(3) | tex | replace(" ", "\\cvsp ")>>}

\begin{cvhonors}
<% for e in s.entries %>
  \cvhonor
    {<<e.award | tex | replace(" ", "\\cvsp ")>>} % Name
    {<<e.issuer | tex | replace(" ", "\\cvsp ")>>} % Issuer
    {<<e.location | tex | replace(" ", "\\cvsp ")>>} % Credential ID
    {<<e.date | tex | replace(" ", "\\cvsp ")>>} % Date(s)
<% endfor %>
\end{cvhonors}
<% endmacro %>

<% macro cvreferences(s) %>
\cvsectionparts{<<s.title.slice(0, 3) | tex>>}{<<s.title.slice(3) | tex | replace(" ", "\\cvsp ")>>}

\begin{cvreferences}
<% for e in s.entries %>
  \cvreference
    {<<e.name | tex | replace(" ", "\\cvsp ")>>}
    {<<e.relation | tex | replace(" ", "\\cvsp ")>>}
    {<<e.phone | tex>>}
    {<<e.email | tex>>}
<% endfor %>
\end{cvreferences}
<% endmacro %>

<% macro cvparagraph(s) %>
\cvsectionparts{<<s.title.slice(0, 3) | tex>>}{<<s.title.slice(3) | tex | replace(" ", "\\cvsp ")>>}

\begin{cvparagraph}
<% for t in s.texts %>
<<t | tex | replace(" ", "\\cvsp ")>>
<% if not loop.last %>

<% endif %>
<% endfor %>
\end{cvparagraph}
<% endmacro %>

<# Dispatch on the section's latexType. #>
<% macro section(s) %>
<% if s.latexType == 'cventries' %>
<<cventries(s)>>
<% elif s.latexType == 'cvskills' %>
<<cvskills(s)>>
<% elif s.latexType == 'cvhonors' %>
<<cvhonors(s)>>
<% elif s.latexType == 'cvreferences' %>
<<cvreferences(s)>>
<% elif s.latexType == 'cvparagraph' %>
<<cvparagraph(s)>>
<% endif %>
<% endmacro %>
